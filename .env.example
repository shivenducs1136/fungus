DATABASE_URL=postgresql://postgres:postgres@db:5432/fungus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fungus

# MCP Server
KNOWLEDGE_SERVER_BASE_URL=http://127.0.0.1:8000
KNOWLEDGE_SERVER_TIMEOUT_SECONDS=15

# Log level for MCP server and git-scripts (DEBUG | INFO | WARNING | ERROR | CRITICAL)
# INFO is the default — set to DEBUG for verbose output, WARNING to suppress routine logs
FUNGUS_LOG_LEVEL=INFO

# Optional: override the directory where log files are written (default: <repo_root>/logs/)
# FUNGUS_LOG_DIR=/path/to/logs
