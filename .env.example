DATABASE_URL=postgresql://postgres:postgres@db:5432/fungus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fungus

# MCP Server
KNOWLEDGE_SERVER_BASE_URL=http://127.0.0.1:8000
KNOWLEDGE_SERVER_TIMEOUT_SECONDS=15

# Log level for MCP server and git-scripts (DEBUG | INFO | WARNING | ERROR | CRITICAL)
# INFO is the default — set to DEBUG for verbose output, WARNING to suppress routine logs
FUNGUS_LOG_LEVEL=INFO

# Optional: override the directory where log files are written (default: <repo_root>/logs/)
# FUNGUS_LOG_DIR=/path/to/logs

# Demo booking email automation
DEMO_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Use one of the following:
SMTP_PASSWORD=
SMTP_PASSWORD_ENCRYPTED=
# Keep the decryption key outside .env using a mounted secret file.
SMTP_CREDENTIALS_KEY_FILE=/run/secrets/smtp_credentials_key
# Optional fallback only (not recommended):
# SMTP_CREDENTIALS_KEY=
SMTP_SENDER_EMAIL=
SMTP_USE_TLS=true
